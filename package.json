{
  "name": "repograph",
  "displayName": "RepoGraph",
  "publisher": "repograph",
  "description": "Central de repositorios para IA: indexa seus projetos com CodeGraphContext (MCP) e da contexto de codigo pronto para Claude Code, Cursor e Copilot.",
  "version": "0.0.1",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "mcp",
    "context",
    "ai",
    "code graph",
    "claude",
    "cursor",
    "copilot"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PedroAugustojardim/RepoGraph.git"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "repograph.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "repograph.addRepository",
        "title": "RepoGraph: Adicionar repositório"
      },
      {
        "command": "repograph.removeRepository",
        "title": "RepoGraph: Remover repositório"
      },
      {
        "command": "repograph.configureMcp",
        "title": "RepoGraph: Configurar integração MCP (IA)"
      },
      {
        "command": "repograph.removeRepositoryItem",
        "title": "RepoGraph: Remover este repositório",
        "icon": "$(trash)"
      },
      {
        "command": "repograph.revealOutput",
        "title": "RepoGraph: Ver log",
        "icon": "$(output)"
      },
      {
        "command": "repograph.visualizeRepository",
        "title": "RepoGraph: Visualizar grafo em 3D"
      },
      {
        "command": "repograph.visualizeRepositoryItem",
        "title": "RepoGraph: Visualizar este repositório em 3D",
        "icon": "$(graph)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repograph",
          "title": "RepoGraph",
          "icon": "images/activity-icon.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "repograph.repositoriesView",
          "name": "RepoGraph: Repositórios"
        }
      ],
      "repograph": [
        {
          "type": "webview",
          "id": "repograph.graphView",
          "name": "Grafo 3D"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "repograph.visualizeRepositoryItem",
          "when": "view == repograph.repositoriesView",
          "group": "inline@1"
        },
        {
          "command": "repograph.removeRepositoryItem",
          "when": "view == repograph.repositoriesView",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "repograph.removeRepositoryItem",
          "when": "false"
        },
        {
          "command": "repograph.revealOutput",
          "when": "false"
        },
        {
          "command": "repograph.visualizeRepositoryItem",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.0",
    "three": "^0.185.1",
    "three-spritetext": "^1.10.0"
  }
}
